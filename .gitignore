# Local user run config — holds Entrez credentials and per-user settings. The
# pipeline falls back to factory defaults when it's absent, so config JSONs are
# never committed to the public repo (both the root copy and the notebooks-dir copy).
/mesh_config.json
src/mesh_aop_notebooks/mesh_config.json

# Scratch notebooks kept locally for ad-hoc testing — not part of the published
# package (no matching source module).
src/mesh_aop_notebooks/test.ipynb
src/mesh_aop_notebooks/test_2.ipynb

# Windows release build outputs (packaging/build_portable_windows.py)
packaging/portable/
packaging/_cache/
packaging/_icon_preview.png
packaging/dist/

# Generated data and results. These are produced by running the pipeline and are
# measured in gigabytes - the master database alone is over 7 GB, well past the
# 100 MB GitHub refuses. Nothing here was ignored before, so a single
# `git add -A` would stage all of it.
#
# The reference corpus under data/reference_processed IS tracked and must stay
# so: it ships inside the release and the bundled ground truth depends on it.
data/raw/*
!data/raw/.gitkeep
!data/raw/aop_annotations_master.csv
!data/raw/ground_truth_pmids.template.csv
data/processed/*
!data/processed/.gitkeep
data/reference_raw/*
!data/reference_raw/.gitkeep
results/*
!results/.gitkeep
# The published reference figures are tracked, like the reference corpus they
# came from: they are the run the paper reports, not output someone regenerated.
# Un-ignoring the directory is what makes the exception work - git will not
# reconsider a file inside a directory it has already excluded.
!results/reference_figures/
results_SNAPSHOT_*.zip

# Local tooling configuration, specific to one machine and one person.
.claude/
mesh_config.json
mesh_config.json.bak*
